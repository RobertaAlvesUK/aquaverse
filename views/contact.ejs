<!-- Include the shared header partial -->
<%- include('partials/header') %>

<!-- Contact form page content -->
<section class="contact-page">
  <% if (successMessage) { %>
    <!-- Show this content after a successful submission -->
    <h1>Message Sent</h1>
    <p class="form-success"><%= successMessage %></p>
    <p>Our AquaVerse team will reply as soon as possible.</p>
  <% } else { %>
    <!-- Show the contact form before submission -->
    <h1>Contact Us</h1>
    <p>Have a question about AquaVerse? Send us a message and our team will be happy to help.</p>

    <!-- Show an error if form data is missing -->
    <% if (errorMessage) { %>
      <p class="form-error"><%= errorMessage %></p>
    <% } %>

<!-- Show client-side validation messages -->
<p id="client-message" aria-live="polite"></p>

<form id="contact-form" action="/contact" method="POST" novalidate>

      <label for="name">Full Name</label>
      <input type="text" id="name" name="name" required>

      <label for="email">Email Address</label>
      <input type="email" id="email" name="email" required>

      <label for="message">Your Message</label>
      <textarea id="message" name="message" rows="6" required></textarea>

      <button type="submit">Send Message</button>
    </form>
  <% } %>
</section>

<!-- Include the shared footer partial -->
<%- include('partials/footer') %>
